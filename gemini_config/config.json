{
  "userSettings": {
    "autoExecutionPolicy": "CASCADE_COMMANDS_AUTO_EXECUTION_EAGER",
    "browserJsExecutionPolicy": "BROWSER_JS_EXECUTION_POLICY_TURBO",
    "enableTerminalSandbox": false,
    "globalPermissionGrants": {
      "allow": [
        "command(Get-ChildItem -Path .)",
        "command(git status; git log -n 5; git branch -a)",
        "command(where.exe git; where.exe python; where.exe node; where.exe claude; where.exe soup)",
        "command(python -m pip list)",
        "mcp(claude-bridge/claude_ask)",
        "mcp(claude-bridge/claude_review)",
        "mcp(claude-bridge/claude_implement)",
        "mcp(claude-bridge/model_ask)",
        "mcp(claude-bridge/models_list)",
        "mcp(claude-bridge/soup_recipe)",
        "mcp(soup/advise)",
        "mcp(soup/recipes_search)"
      ]
    },
    "nonWorkspaceFileAccessPolicy": "AGENT_SETTING_POLICY_ALLOW",
    "queuedMessageDeliveryStrategy": "MESSAGE_DELIVERY_STRATEGY_NEXT_INVOCATION",
    "remoteControlEnabled": true
  }
}