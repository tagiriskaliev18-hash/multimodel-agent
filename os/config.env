# DuoOS — параметры сборки.
# Всё, что касается имени и версии системы, меняется только здесь.

OS_NAME="DuoOS"
OS_ID="duoos"
OS_VERSION="1.0"
OS_CODENAME="Genesis"
OS_TAGLINE="Операционная система для разработчиков"
OS_URL="https://github.com/tagiriskaliev18-hash/multimodel-agent"

# База: Ubuntu 26.04 LTS (как у Linux Mint — стабильная LTS-основа, поддержка до 2031 года)
UBUNTU_SUITE="resolute"
UBUNTU_MIRROR="http://archive.ubuntu.com/ubuntu"
ARCH="amd64"

# Пользователь live-сессии (без пароля, только для USB/DVD)
LIVE_USER="duo"
LIVE_HOSTNAME="duoos"

# Язык live-системы по умолчанию (в установщике можно выбрать любой)
DEFAULT_LOCALE="ru_RU.UTF-8"
DEFAULT_KEYBOARD="us,ru"
DEFAULT_TIMEZONE="Asia/Almaty"

# Сжатие squashfs: xz — меньше ISO, zstd — быстрее сборка
SQUASHFS_COMP="${SQUASHFS_COMP:-xz}"
