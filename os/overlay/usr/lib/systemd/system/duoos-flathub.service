[Unit]
Description=DuoOS: подключение магазина приложений Flathub
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/flatpak/repo/flathub.trustedkeys.gpg

[Service]
Type=oneshot
ExecStart=/usr/bin/flatpak remote-add --if-not-exists --system flathub https://dl.flathub.org/repo/flathub.flatpakrepo
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
