# ========================================================
# 🔑 AI Duo Environment Configuration Template
# ========================================================

# Host & Port Settings
HOST=0.0.0.0
PORT=8000

# OpenAI API Key (for GPT-4o, GPT-4o-mini, o1, o3-mini)
OPENAI_API_KEY=

# OpenRouter API Key (for Nous Hermes 3 70B/405B, Llama 3.3)
OPENROUTER_API_KEY=

# Groq API Key (for free ultra-fast Llama 3.3 70B inference)
GROQ_API_KEY=

# Ollama Endpoint (for local offline Hermes / OpenHermes)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Default Provider & Model
AIDUO_DEFAULT_PROVIDER=hermes
AIDUO_DEFAULT_MODEL=hermes-3
